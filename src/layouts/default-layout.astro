---
import Breadcrumbs from "@/components/breadcrumbs.astro";
import { Font } from "astro:assets";

interface Props {
    breadcrumbs?: { name: string; href: string }[];
    summary?: string;
    title: string;
}

// Special syntax to work when used by Markdown and Astro files.
const { breadcrumbs, summary, title } = Astro.props.frontmatter || Astro.props;
const buildYear = new Date().getFullYear();
const buildDate = new Date().toISOString();
---

<!doctype html>
<html lang="en" class="H(100%) Ovy(h)">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <Font cssVariable="--font-ubuntu" />
        <Font cssVariable="--font-anonymous-pro" />
        <title>{title}</title>
        <style is:global>
            @import url("@/assets/styles.css");
        </style>
        <script src="@fidian/acss-live/acss-live.js"></script>

        <!-- Favicon generated content from http://realfavicongenerator.net/ -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/img/favicon/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/img/favicon/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/img/favicon/favicon-16x16.png"
        />
        <link rel="manifest" href="/img/favicon/manifest.json" />
        <link
            rel="mask-icon"
            href="/img/favicon/safari-pinned-tab.svg"
            color="#5bbad5"
        />
        <link rel="shortcut icon" href="/img/favicon/favicon.ico" />
        <meta
            name="msapplication-config"
            content="/img/favicon/browserconfig.xml"
        />
        <meta name="theme-color" content="#ffffff" />
        <!-- End of favicon generated content -->

        <link rel="license" href="/license/" />

        <!-- Google Analytics -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-H1S197ZSNH"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-H1S197ZSNH");
        </script>
        <!-- End of Google Analytics -->
    </head>
    <body class="H(100%) Ovx(h) Bgc(--page-border-background) Bgc(tr)--p">
        <div
            class="Maw(1002px) H(100%) W(100%) D(f) Fxd(c) Maw(100%)--p Mx(a) Mx(0)--p"
        >
            <Breadcrumbs breadcrumbs={breadcrumbs || []} />
            <div class="Bgc(--page-background) Bgc(tr)--p Fxg(1)">
                <div class="Mt(50px) Mt(0)--p C(--text-color-normal) P(10px)">
                    <div
                        class="Mx(a) W(100%) Maw(--content-width-max) Maw(100%)--p D(f) Px(10px) Pstart(0)"
                    >
                        <main class="D(tbc) Va(t) W(100%)">
                            <header>
                                <h1>
                                    {title}
                                </h1>

                                {
                                    summary && (
                                        <div class="Px(20px)">
                                            <div class="Bgc(#c5e0f9) Bgc(tr)--p Fs(i) Py(4px) Px(8px)">
                                                {summary}
                                            </div>
                                        </div>
                                    )
                                }
                                <div class="contents">
                                    <slot />
                                </div>
                            </header>
                        </main>
                    </div>
                </div>
            </div>
            <footer
                class="Bgc(--bar-background) Bgc(tr)--p Bdtw(1px) Bdc(--bar-border) C(--bar-text) C(black)--p P(10px) D(f) Fxd(c)--p Jc(spb)"
            >
                <div class="Fz(0.8em)">
                    &copy; Copyright {buildYear} Tyler Akins &lt;<a
                        class="Td(n)--p C(--bar-text) C(black)--p"
                        href="mailto:fidian@rumkin.com">fidian@rumkin.com</a
                    >&gt;, last build {buildDate}
                </div>
                <div>
                    <a class="D(n)--p Fz(0.8em) C(--bar-text)" href="/license/"
                        >MIT License</a
                    > |
                    <a
                        class="D(n)--p Fz(0.8em) C(--bar-text)"
                        href="/reference/site/legal/">Legal</a
                    >
                </div>
            </footer>
        </div>
    </body>
</html>
