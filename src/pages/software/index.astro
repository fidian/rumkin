---
import DefaultLayout from "@/layouts/default-layout.astro";
import ChildPages from "@/components/child-pages.astro";

export const title = "Software Projects";

const breadcrumbs = [{ name: "Rumkin.com", href: "/" }];
---

<DefaultLayout title={title} breadcrumbs={breadcrumbs}>
    <p>
        I wrote a bunch of little tools and pieces of software. Other things
        have been found on the internet but have not stuck around, so I mirrored
        a couple of those useful things onto my site for safe storage.
    </p>

    <ChildPages base="/software/" />
</DefaultLayout>
