{
    "name": "rumkin",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "npm run build-dist && npm run build-sitemap && npm run verify-internal-links",
        "build-dist": "astro build",
        "build-sitemap": "node build-sitemap.mjs",
        "preview": "astro preview",
        "reinstall": "rm -rf node_modules package-lock.json && npm install",
        "start": "astro dev --open --host",
        "test": "npm run build && npm run verify-external-links && npm run verify-internal-links",
        "verify-external-links": "checklinks -a",
        "verify-internal-links": "check-html-links dist/ --ignore-link-pattern 'image.php/**' 'js/keymaker.js' 'css/base.css' 'css/normal.css' 'index.xml' 2>&1 | tee /dev/stderr | ( ! grep -q '❌' )"
    },
    "dependencies": {
        "@fidian/acss-live": "^3.1.0",
        "@johnwargo/link-checker": "^0.0.9",
        "@literals/rollup-plugin-html-css-minifier": "^4.0.0",
        "@rollup/plugin-yaml": "^4.1.2",
        "@types/node": "^25.5.0",
        "astro": "^7.3.3",
        "check-html-links": "^0.2.4",
        "fudgel": "^4.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "^5.9.3"
    }
}
